{
  "name": "trippilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "TripPilot AI — AI travel planning with transportation-aware itineraries.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "1.31.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
